#~/.config/mini-swe-agent/.env
MSWEA_CONFIGURED='true'
MSWEA_REASONING_EFFORT='high'


# kimi
MSWEA_MODEL_NAME='openai/kimi-for-coding'
OPENAI_API_KEY='sk-kimi-place-holder'
OPENAI_BASE_URL='https://api.kimi.com/coding/v1'
OPENAI_API_BASE='https://api.kimi.com/coding/v1'
MSWEA_COST_TRACKING='ignore_errors'

# Deepseek 
MSWEA_MODEL_NAME='openai/deepseek-flash'
OPENAI_API_KEY='sk-deepseek-place-holder'
OPENAI_BASE_URL='https://api.deepseek.com'
OPENAI_API_BASE='https://api.deepseek.com'
MSWEA_COST_TRACKING='ignore_errors'


# ollama 
MSWEA_MODEL_NAME='ollama_chat/deepseek-v4.1-flash:cloud'
OLLAMA_API_BASE='http://localhost:11434'
MSWEA_CONFIGURED='true'
MSWEA_COST_TRACKING='ignore_errors'
