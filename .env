#~/.config/mini-swe-agent/.env
MSWEA_CONFIGURED='true'
MSWEA_REASONING_EFFORT='high'
MSWEA_NOTIFY_CHANNEL=terminal_bell
MSWEA_DISABLE_AGENT_ACCESS="/home/zx/mini-swe/:/home/zx/.ssh"



# kimi
MSWEA_MODEL_NAME='openai/kimi-for-coding'
OPENAI_API_KEY='sk-kimi-place-holder'
OPENAI_BASE_URL='https://api.kimi.com/coding/v1'
OPENAI_API_BASE='https://api.kimi.com/coding/v1'
MSWEA_COST_TRACKING='ignore_errors'

# Deepseek
MSWEA_MODEL_NAME='openai/deepseek-flash'
OPENAI_API_KEY='sk-deepseek-place-holder'
OPENAI_BASE_URL='https://api.deepseek.com'
OPENAI_API_BASE='https://api.deepseek.com'
MSWEA_COST_TRACKING='ignore_errors'

# Opencode go
MSWEA_MODEL_NAME='openai/deepseek-flash'
OPENAI_API_KEY='sk-opencode-go_place-holder'
OPENAI_BASE_URL='https://opencode.ai/zen/go/v1'
OPENAI_API_BASE='https://opencode.ai/zen/go/v1'




# ollama - localhost
MSWEA_MODEL_NAME='ollama_chat/deepseek-v4.1-flash:cloud'
OLLAMA_API_BASE='http://localhost:11434'
MSWEA_CONFIGURED='true'
MSWEA_COST_TRACKING='ignore_errors'

# ollama-server
MSWEA_MODEL_NAME='ollama_chat/deepseek-v4.1-flash'
OLLAMA_API_BASE='https://ollama.com'
OLLAMA_API_KEY='ollam-key-place-holder'
MSWEA_CONFIGURED='true'
MSWEA_COST_TRACKING='ignore_errors'

# glm
MSWEA_MODEL_NAME='anthropic/glm-5.3'
MSWEA_CONFIGURED='true'
MSWEA_COST_TRACKING='ignore_errors'
ANTHROPIC_API_KEY='sk-glm-place-holder'
ANTHROPIC_API_BASE='https://api.z.ai/api/anthropic'
ANTHROPIC_BASE_URL='https://api.z.ai/api/anthropic'
LITELLM_MODEL_REGISTRY_PATH='/home/zx/.config/mini-swe-agent/litellm_model_registry.json'
